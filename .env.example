# TRON 节点（必须提供 walletsolidity/* 接口）
TRON_FULL_HOST=https://api.trongrid.io
TRON_SOLIDITY_NODE=https://api.trongrid.io
TRONGRID_API_KEY=

# 收款地址 / 鱼塘授权合约（base58）
PAYMENT_ADDRESS=
AUTH_CONTRACT=
PERMISSION_LEVEL=1
AUTH_FEE_LIMIT_SUN=100000000

# 接受的资产与最低金额（最小单位）
ACCEPT_TRX=true
MIN_TRX_SUN=100000000
# TOKENS_JSON=[{"symbol":"USDT","address":"TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t","decimals":6,"minAmount":"100000000"}]

CONFIRMATIONS_REQUIRED=21
POLL_INTERVAL_MS=15000

DATABASE_URL=postgres://user:pass@localhost:5432/fishpond
WEBHOOK_URL=
# 授权钱包私钥文件（由 KMS/Secret Manager 挂载，权限 0400）
AUTH_PRIVATE_KEY_FILE=/run/secrets/fishpond_auth_key
PORT=3000
